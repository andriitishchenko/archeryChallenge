# Local development defaults. Copy to backend/.env and change values as needed.
APP_ENV=development
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Local SQLite is for development only. Production requires PostgreSQL.
DATABASE_URL=sqlite:///./arrowmatch.db

# The app is same-origin by default; add explicit origins only for separate frontends.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000
DEBUG=false
APP_BASE_URL=http://localhost:8000

# Password recovery email. Configure SMTP_HOST for real email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=noreply@arrowmatch.local
PASSWORD_RESET_EXPIRE_MINUTES=60

# Authentication throttling
AUTH_RATE_LIMIT=5
AUTH_RATE_WINDOW=900
GUEST_RATE_LIMIT=20

# Matchmaking and expiry
BOT_WAIT_SECONDS=8
MATCHMAKING_TIMEOUT=30
EXPIRY_CHECK_INTERVAL_SECONDS=60
MATCH_INACTIVITY_SECONDS=172800

# Production requires APP_ENV=production, a generated SECRET_KEY, a
# TLS-enabled PostgreSQL DATABASE_URL, an HTTPS APP_BASE_URL, configured SMTP, DEBUG=false,
# a real EMAIL_FROM address, and explicit HTTPS CORS_ORIGINS when the frontend
# is hosted separately.
